# Copy this file to ".env" and put your real key there.
# NEVER commit .env to GitHub.
GEMINI_API_KEY=paste-your-key-here

# "gemini-flash-latest" always points to Google's newest Flash model.
# You can also pin a fixed model, e.g. gemini-3.5-flash
GEMINI_MODEL=gemini-flash-latest

# Optional: ask for a login before using the app (recommended for a public link)
# APP_USERNAME=group1
# APP_PASSWORD=choose-a-password

# Optional: max Gemini calls per hour for all users together (protects your bill)
# MAX_LLM_CALLS_PER_HOUR=100
